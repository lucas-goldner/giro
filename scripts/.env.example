# Copy to scripts/.env (gitignored) and fill in. The same values live in
# Codemagic's environment groups; never commit the filled-in file.

# App Store Connect API key (required for the build number and the upload).
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API.
# The same key works for every app on the account.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Group "discord" (optional)
DISCORD_WEBHOOK_URL=

# Optional: a specific Flutter, e.g. FLUTTER="fvm flutter" and DART="fvm dart"
# FLUTTER=flutter
# DART=dart
